[Unit]
Description=KlipperDWIN display interface
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@KLIPPERDWIN_USER@
@SUPPLEMENTARY_GROUPS@
WorkingDirectory=@KLIPPERDWIN_HOME@/KlipperDWIN
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@KLIPPERDWIN_HOME@/.config/KlipperDWIN/KlipperDWIN.env
ExecStart=@KLIPPERDWIN_HOME@/klipperdwin-env/bin/python @KLIPPERDWIN_HOME@/KlipperDWIN/run.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
