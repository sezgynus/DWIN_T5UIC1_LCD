# Install as /etc/default/dwin-lcd (root-owned, mode 0600).
# Values are systemd EnvironmentFile syntax, not a shell script.
MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_API_KEY=
DWIN_REQUEST_TIMEOUT=5
# Verify this UART is routed to the display's RX/TX pins on your Pi model.
DWIN_SERIAL_PORT=/dev/ttyAMA0
# BCM numbers, in the same A/B order as --encoder-pins.
DWIN_ENCODER_PINS="21 19"
DWIN_BUTTON_PIN=13
DWIN_SETTINGS_FILE=/var/lib/dwin-lcd/presets.json

# Moonraker [power <name>] device enabled by holding the encoder button for 3 seconds.
DWIN_POWER_DEVICE=Printer
