# KlipperDWIN runtime configuration.
# Values use systemd EnvironmentFile syntax, not shell syntax.
MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_API_KEY=
DWIN_REQUEST_TIMEOUT=5
# Verify this UART is routed to the display's RX/TX pins on your Pi model.
DWIN_SERIAL_PORT=/dev/ttyS0
# BCM numbers, in the same A/B order as --encoder-pins.
DWIN_ENCODER_PINS="21 19"
DWIN_BUTTON_PIN=20
DWIN_SETTINGS_FILE=~/.config/KlipperDWIN/presets.json

# Moonraker [power <name>] device enabled by holding the encoder button for 2 seconds.
DWIN_POWER_DEVICE=Printer
